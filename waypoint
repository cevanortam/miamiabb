  const HEADER_KEYS = {
    containerId: ['container id','container'],
    sku: ['sku'],
    description: ['sku description','description','item description'],
    qty: ['qty','quantity'],
    upc: ['upc','upc code','barcode','ean']
  };
  function normHeader(s){ return String(s||'').toLowerCase().trim(); }
  function detectHeaderRow(rows, wantedKeys){
    const limit = Math.min(rows.length, 6);
    for(let r=0;r<limit;r++){
      const row = rows[r];
      if(!row) continue;
      const map = {};
      let hits = 0;
      row.forEach((cell, c) => {
        const h = normHeader(cell);
        if(!h) return;
        wantedKeys.forEach(key => {
          if(map[key] !== undefined) return;
          if(HEADER_KEYS[key].some(kw => h === kw || h.includes(kw))){
            map[key] = c; hits++;
          }
        });
      });
      if(hits >= Math.min(2, wantedKeys.length)) return { rowIndex: r, map };
    }
    return null;
  }
  function toNumber(v){
    if(v === null || v === undefined || v === '') return NaN;
    if(typeof v === 'number') return v;
    return parseFloat(String(v).replace(/[, ]/g,''));
  }
  function workbookToRows(wb){
    const sheetName = wb.SheetNames[0];
    return XLSX.utils.sheet_to_json(wb.Sheets[sheetName], { header: 1, raw: true, defval: '' });
  }
  function readWorkbook(file, cb){
    const reader = new FileReader();
    reader.onerror = () => cb(new Error('Could not read that file.'));
    reader.onload = (e) => {
      try{
        const data = new Uint8Array(e.target.result);
        const wb = XLSX.read(data, { type: 'array' });
        cb(null, workbookToRows(wb));
      }catch(err){ cb(err); }
    };
    reader.readAsArrayBuffer(file);
  }

  function parseRawDataset(rows){
    const header = detectHeaderRow(rows, ['containerId','sku','qty','description']);
    if(!header || header.map.containerId === undefined || header.map.sku === undefined || header.map.qty === undefined){
      throw new Error('Could not find Container ID / SKU / Qty columns in this file.');
    }
    const out = [];
    for(let r = header.rowIndex + 1; r < rows.length; r++){
      const row = rows[r] || [];
      const containerId = String(row[header.map.containerId] ?? '').trim();
      const sku = String(row[header.map.sku] ?? '').trim();
      const qty = toNumber(row[header.map.qty]);
      if(!containerId || !sku) continue;
      if(!Number.isFinite(qty) || qty <= 0) continue;
      out.push({
        containerId,
        sku,
        description: header.map.description !== undefined ? String(row[header.map.description] ?? '').trim() : '',
        qty
      });
    }
    return out;
  }

  function handleDatasetFile(file){
    readWorkbook(file, (err, rows) => {
      if(err){ toast(err.message, true); return; }
      try{
        const parsed = parseRawDataset(rows);
        if(parsed.length === 0) throw new Error('No usable Container ID / SKU / Qty rows found.');
        rawDataset = parsed;
        const containers = new Set(parsed.map(r=>normCode(r.containerId)));
        el('datasetStatus').classList.add('show');
        el('datasetStatusText').textContent = `${parsed.length} line${parsed.length===1?'':'s'} across ${containers.size} container${containers.size===1?'':'s'} loaded.`;
        el('clearDatasetBtn').style.display = 'inline-flex';
        el('datasetPill').textContent = `${containers.size} containers loaded`;
        el('datasetPill').className = 'pill ok';
        el('containerInput').disabled = false;
        el('datasetWaitingNote').hidden = true;
        if(!sheetSyncConfigured()){
          toast('Manifest data loaded.');
        }else{
          pushManifestToSheet(rawDataset).then(res => {
            toast(res && res.ok ? 'Manifest data loaded and shared with everyone.' : 'Manifest data loaded, but sharing it failed (check your connection).', !(res && res.ok));
          });
        }
      }catch(e2){
        toast('Could not parse this file: ' + e2.message, true);
      }
    });
  }

