<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meridian | Outbound Audit</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
<style>

  :root{
    --bg:#12151b; --panel:#1a1f27; --panel-alt:#212832; --border:#2c333e; --border-soft:#242b35;
    --text:#e9ecf1; --muted:#8a94a3; --muted-dim:#5f6875;
    --amber:#f2a93b; --amber-deep:#c9821a; --blue:#5b93ff; --red:#e4572e; --green:#46b378;
    --mono:'IBM Plex Mono','Consolas',monospace; --disp:'Oswald','Segoe UI Semibold',sans-serif; --sans:'Inter','Segoe UI',sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:radial-gradient(1100px 500px at 85% -10%, rgba(242,169,59,0.06), transparent 60%), var(--bg); color:var(--text); font-family:var(--sans); min-height:100vh;}
  ::selection{background:var(--amber);color:#1a1305;}

  .topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;border-bottom:1px solid var(--border);background:linear-gradient(180deg, var(--panel), rgba(26,31,39,0.85));position:sticky;top:0;z-index:40;backdrop-filter:blur(6px);}
  .brand{display:flex;align-items:center;gap:12px;}
  .brand .logo-badge{height:34px;width:34px;padding:0;border-radius:6px;background:#f5f5f5;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex:none;}
  .brand .logo-badge span{font-family:var(--disp);font-weight:700;font-size:14px;color:#12151b;}
  .brand h1{font-family:var(--disp);font-weight:600;letter-spacing:0.3px;font-size:19px;margin:0;text-transform:uppercase;}
  .brand p{margin:0;font-size:11.5px;color:var(--muted);font-family:var(--mono);letter-spacing:0.4px;}
  .topbar-right{display:flex;align-items:center;gap:10px;}
  .pill{font-family:var(--mono);font-size:11px;letter-spacing:0.5px;padding:5px 10px;border-radius:20px;border:1px solid var(--border);color:var(--muted);white-space:nowrap;}
  .pill.ok{border-color:rgba(70,179,120,0.5);color:var(--green);}
  .pill.warn{border-color:rgba(228,87,46,0.5);color:var(--red);}
  .pill.amber{border-color:var(--amber-deep);color:var(--amber);}

  .layout{display:flex;align-items:flex-start;min-height:calc(100vh - 63px);position:relative;}
  .sidebar{width:320px;flex:none;padding:20px;border-right:1px solid var(--border);display:flex;flex-direction:column;gap:18px;position:sticky;top:63px;height:calc(100vh - 63px);overflow-y:auto;}
  .workspace{flex:1;min-width:0;padding:20px 24px 60px;position:relative;}

  .card{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:16px;}
  .card h2{font-family:var(--disp);font-size:13px;text-transform:uppercase;letter-spacing:0.6px;margin:0 0 10px;color:var(--text);font-weight:600;display:flex;align-items:center;gap:8px;}
  .card h2 .num{color:var(--amber);font-family:var(--mono);font-size:11px;border:1px solid var(--amber-deep);border-radius:4px;padding:1px 6px;}
  .card p.hint{font-size:12px;color:var(--muted);line-height:1.5;margin:0 0 10px;}

  .dropzone{border:1.5px dashed var(--border);border-radius:8px;padding:16px 12px;text-align:center;cursor:pointer;transition:all .15s ease;background:var(--panel-alt);position:relative;}
  .dropzone:hover, .dropzone.drag{border-color:var(--amber);background:rgba(242,169,59,0.06);}
  .dropzone svg{opacity:0.7;margin-bottom:4px;}
  .dropzone .dz-title{font-size:12.5px;font-weight:600;}
  .dropzone .dz-sub{font-size:11px;color:var(--muted);margin-top:3px;}
  input[type=file]{display:none;}
  .file-status{margin-top:9px;font-family:var(--mono);font-size:11px;color:var(--muted);display:none;align-items:flex-start;gap:7px;background:var(--panel-alt);border:1px solid var(--border-soft);border-radius:6px;padding:8px 9px;}
  .file-status.show{display:flex;}
  .file-status .dot{width:7px;height:7px;border-radius:50%;background:var(--green);margin-top:4px;flex:none;}

  .btn{font-family:var(--sans);font-weight:600;font-size:13px;letter-spacing:0.2px;border-radius:7px;padding:9px 14px;border:1px solid var(--border);background:var(--panel-alt);color:var(--text);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:all .12s ease;}
  .btn:hover{border-color:var(--muted-dim);transform:translateY(-1px);}
  .btn:active{transform:translateY(0);}
  .btn.primary{background:linear-gradient(180deg,#ffc266,var(--amber));border-color:var(--amber-deep);color:#1a1305;}
  .btn.primary:hover{filter:brightness(1.05);}
  .btn.ghost{background:transparent;}
  .btn.danger-outline{border-color:rgba(228,87,46,0.55);color:#ffb199;}
  .btn.danger-outline:hover{background:rgba(228,87,46,0.08);}
  .btn.sm{padding:6px 10px;font-size:12px;}
  .btn:disabled{opacity:0.4;cursor:not-allowed;transform:none;}
  .btn.icon-x{width:24px;height:24px;padding:0;border-radius:5px;font-size:13px;flex:none;}
  .btn.wide{width:100%;}
  .btn-row{display:flex;gap:8px;flex-wrap:wrap;}

  .field{margin-bottom:12px;}
  .field:last-child{margin-bottom:0;}
  .field label{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px;margin-bottom:5px;font-family:var(--mono);}
  .field input, .field select{width:100%;background:var(--panel-alt);border:1px solid var(--border);border-radius:7px;padding:9px 11px;color:var(--text);font-family:var(--mono);font-size:13px;}
  .field input:focus, .field select:focus{outline:none;border-color:var(--amber);}

  .badge{font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:0.4px;padding:3px 8px;border-radius:5px;border:1px solid;display:inline-block;}
  .badge.ok{color:var(--green);border-color:rgba(70,179,120,0.5);background:rgba(70,179,120,0.08);}
  .badge.warn{color:#ffb199;border-color:rgba(228,87,46,0.55);background:rgba(228,87,46,0.08);}
  .badge.plain{color:var(--muted);border-color:var(--border);}
  .badge.amber{color:var(--amber);border-color:var(--amber-deep);background:rgba(242,169,59,0.08);}

  .toast{position:fixed;bottom:24px;right:22px;background:var(--panel);border:1px solid var(--border);color:var(--text);padding:12px 16px;border-radius:8px;font-size:13px;box-shadow:0 12px 30px rgba(0,0,0,.4);z-index:999;max-width:340px;display:none;font-family:var(--sans);}
  .toast.error{border-color:rgba(228,87,46,0.6);color:#ffb199;}
  .toast.show{display:block;animation:fadein .15s ease-out;}
  @keyframes fadein{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

  .modal-overlay{position:fixed;inset:0;background:rgba(8,9,12,0.72);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;z-index:200;padding:20px;}
  .modal-overlay.hidden{display:none;}
  .modal{background:var(--panel);border:1px solid var(--border);border-radius:12px;width:100%;max-width:460px;padding:22px;box-shadow:0 20px 60px rgba(0,0,0,0.5);}
  .modal.wide{max-width:760px;max-height:86vh;display:flex;flex-direction:column;}
  .modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex:none;}
  .modal-head h3{font-family:var(--disp);text-transform:uppercase;font-size:16px;letter-spacing:0.4px;margin:0;flex:1;font-weight:600;}
  .modal-close{background:none;border:none;color:var(--muted);cursor:pointer;font-size:20px;padding:2px 6px;line-height:1;}
  .modal-close:hover{color:var(--text);}
  .modal-body{overflow-y:auto;flex:1;}

  /* ---- login overlay ---- */
  .login-overlay{position:fixed;inset:0;background:radial-gradient(1100px 500px at 85% -10%, rgba(242,169,59,0.06), transparent 60%), var(--bg);z-index:500;display:flex;align-items:center;justify-content:center;padding:20px;}
  .login-overlay.hidden{display:none;}
  .login-card{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:32px;width:100%;max-width:360px;box-shadow:0 20px 60px rgba(0,0,0,0.5);}
  .login-card .brand{justify-content:center;margin-bottom:22px;}
  .login-card h2{font-family:var(--disp);font-size:15px;text-transform:uppercase;letter-spacing:0.4px;margin:0 0 18px;text-align:center;color:var(--text);}
  .login-error{background:rgba(228,87,46,0.1);border:1px solid rgba(228,87,46,0.4);color:#ffb199;border-radius:7px;padding:8px 11px;font-size:12.5px;margin-bottom:12px;display:none;}
  .login-error.show{display:block;}
  .login-hint{font-family:var(--mono);font-size:10.5px;color:var(--muted-dim);text-align:center;margin-top:16px;line-height:1.6;}

  /* ---- settings modal / user table ---- */
  .settings-lock{text-align:center;padding:10px 0 4px;}
  .settings-lock p{color:var(--muted);font-size:12.5px;margin:0 0 16px;}
  .settings-unlocked{display:none;}
  .settings-unlocked.show{display:block;}
  table.usertable{width:100%;border-collapse:collapse;font-size:12.5px;}
  table.usertable th{text-align:left;font-family:var(--mono);font-size:10px;text-transform:uppercase;color:var(--muted);padding:6px 8px;border-bottom:1px solid var(--border);}
  table.usertable td{padding:6px 8px;border-bottom:1px solid var(--border-soft);color:var(--text);}
  table.usertable input{background:var(--panel-alt);border:1px solid var(--border);color:var(--text);font-family:var(--mono);font-size:12.5px;border-radius:6px;padding:5px 7px;width:100%;}
  .security-note{font-size:11px;color:var(--muted-dim);line-height:1.6;background:var(--panel-alt);border:1px solid var(--border-soft);border-radius:7px;padding:10px 12px;margin-top:14px;}

  .container-hero{max-width:640px;margin:60px auto 0;text-align:center;}
  .container-hero .eyebrow{font-family:var(--mono);font-size:11.5px;color:var(--amber);letter-spacing:0.14em;text-transform:uppercase;margin-bottom:10px;}
  .container-hero h2{font-family:var(--disp);font-size:26px;margin:0 0 8px;text-transform:uppercase;letter-spacing:0.3px;}
  .container-hero p{color:var(--muted);font-size:13.5px;line-height:1.6;margin:0 auto 26px;max-width:480px;}
  .container-scan-wrap{position:relative;}
  #containerInput{
    width:100%;font-family:var(--mono);font-size:22px;font-weight:700;letter-spacing:0.03em;text-align:center;text-transform:uppercase;
    padding:18px 20px;border-radius:10px;border:2px solid var(--border);background:var(--panel-alt);color:var(--text);outline:none;
  }
  #containerInput:focus{border-color:var(--amber);}
  #containerInput:disabled{opacity:.5;}
  .dataset-waiting{font-family:var(--mono);font-size:12px;color:var(--muted-dim);margin-top:14px;}

  .notfound-box{
    max-width:520px;margin:22px auto 0;padding:18px 20px;background:rgba(228,87,46,0.08);
    border:1px solid rgba(228,87,46,0.4);border-radius:10px;color:#ffb199;font-size:13.5px;text-align:left;
  }
  .notfound-box b{color:#ffcdbd;}
  .notfound-box .btn-row{margin-top:14px;}

  .container-strip{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:16px;
  }
  .container-strip .cid{font-family:var(--mono);font-weight:700;font-size:16px;color:var(--amber);}
  .container-strip .cid-sub{font-family:var(--mono);font-size:11px;color:var(--muted);}

  .stats-row{display:flex;gap:8px;margin-bottom:16px;}
  .stat{flex:1;background:var(--panel-alt);border:1px solid var(--border-soft);border-radius:7px;padding:9px 8px;text-align:center;}
  .stat .n{font-family:var(--mono);font-size:19px;font-weight:700;color:var(--amber);}
  .stat.complete .n{color:var(--green);}
  .stat .l{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px;margin-top:2px;}
  .progress-track{height:6px;background:var(--border-soft);border-radius:4px;overflow:hidden;margin-bottom:18px;}
  .progress-fill{height:100%;background:linear-gradient(90deg,var(--amber-deep),var(--amber));border-radius:4px;transition:width .25s ease;}

  .scan-panel{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:16px;}
  .scan-panel label{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px;margin-bottom:8px;font-family:var(--mono);}
  .scan-row{display:flex;gap:10px;align-items:stretch;}
  #scanInput{
    flex:1;min-width:0;font-family:var(--mono);font-size:19px;font-weight:600;padding:15px 16px;border-radius:9px;
    border:2px solid var(--border);background:var(--panel-alt);color:var(--text);outline:none;text-transform:uppercase;
  }
  #scanInput:focus{border-color:var(--amber);}
  .scan-qty-wrap{flex:none;width:96px;display:flex;flex-direction:column;}
  .scan-qty-wrap .sq-label{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px;margin-bottom:4px;font-family:var(--mono);text-align:center;}
  #scanQtyInput{
    width:100%;font-family:var(--mono);font-size:19px;font-weight:700;padding:15px 8px;border-radius:9px;text-align:center;
    border:2px solid var(--border);background:var(--panel-alt);color:var(--amber);outline:none;
  }
  #scanQtyInput:focus{border-color:var(--amber);}
  .scan-feedback{
    margin-top:10px;min-height:42px;display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:8px;font-size:13.5px;font-weight:600;
    background:var(--panel-alt);border:1px solid var(--border-soft);color:var(--muted);
  }
  .scan-feedback.ok{background:rgba(70,179,120,0.1);color:var(--green);border-color:rgba(70,179,120,0.4);}
  .scan-feedback.warn{background:rgba(242,169,59,0.1);color:var(--amber);border-color:var(--amber-deep);}
  .scan-feedback.err{background:rgba(228,87,46,0.1);color:#ffb199;border-color:rgba(228,87,46,0.5);}
  .scan-feedback .fb-badge{font-family:var(--mono);font-size:11px;padding:2px 7px;border-radius:5px;background:rgba(255,255,255,0.06);}
  .scan-panel-actions{margin-top:10px;}

  .over-banner{background:rgba(228,87,46,0.08);border:1px solid rgba(228,87,46,0.4);color:#ffb199;border-radius:10px;padding:10px 14px;font-size:13px;font-weight:600;margin-bottom:14px;}

  .toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:18px 0 10px;flex-wrap:wrap;}
  .toolbar h3{font-family:var(--disp);font-size:15px;margin:0;text-transform:uppercase;letter-spacing:0.4px;}
  .search-box{display:flex;align-items:center;gap:8px;background:var(--panel-alt);border:1px solid var(--border);border-radius:8px;padding:7px 10px;font-size:13px;}
  .search-box input{border:none;outline:none;font-family:var(--sans);font-size:13px;width:180px;background:transparent;color:var(--text);}

  .table-wrap{background:var(--panel);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:16px;}
  table.manifest{width:100%;border-collapse:collapse;font-size:13px;}
  table.manifest thead th{text-align:left;font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:0.5px;color:var(--muted);background:var(--panel-alt);padding:10px 12px;border-bottom:1px solid var(--border);white-space:nowrap;}
  table.manifest td{padding:9px 12px;border-bottom:1px solid var(--border-soft);color:var(--text);vertical-align:middle;}
  table.manifest tbody tr:last-child td{border-bottom:none;}
  table.manifest tbody tr:hover{background:rgba(242,169,59,0.03);}
  table.manifest tbody tr.just-scanned{animation:flashRow .9s ease;}
  @keyframes flashRow{0%{background:rgba(70,179,120,0.18);}100%{background:transparent;}}
  .sku-cell{font-family:var(--mono);font-weight:700;color:var(--amber);}
  .upc-cell{font-family:var(--mono);font-size:11.5px;color:var(--muted);}
  .desc-cell{color:var(--muted);font-size:12px;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .qty-cell{font-family:var(--mono);text-align:center;font-weight:600;}
  .remaining-cell{font-family:var(--mono);text-align:center;font-weight:700;}
  .remaining-cell.zero{color:var(--green);}
  .remaining-cell.over{color:var(--red);}
  .status-chip{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.4px;padding:4px 9px;border-radius:20px;font-family:var(--mono);}
  .status-chip.pending{background:var(--panel-alt);color:var(--muted);border:1px solid var(--border);}
  .status-chip.progress{background:rgba(242,169,59,0.1);color:var(--amber);border:1px solid var(--amber-deep);}
  .status-chip.complete{background:rgba(70,179,120,0.1);color:var(--green);border:1px solid rgba(70,179,120,0.5);}
  .status-chip.over{background:rgba(228,87,46,0.1);color:var(--red);border:1px solid rgba(228,87,46,0.5);}
  .row-controls{display:flex;gap:6px;align-items:center;justify-content:flex-end;}
  .mini-btn{width:24px;height:24px;border-radius:6px;border:1px solid var(--border);background:var(--panel-alt);cursor:pointer;font-family:var(--mono);font-weight:700;font-size:13px;display:flex;align-items:center;justify-content:center;color:var(--muted);}
  .mini-btn:hover{border-color:var(--muted-dim);color:var(--text);}
  .empty-row td{padding:24px;text-align:center;color:var(--muted);font-size:13px;}

  .log-panel{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:14px 16px;}
  .log-panel h3{font-family:var(--disp);font-size:13px;margin:0 0 10px;text-transform:uppercase;letter-spacing:0.4px;}
  .log-list{max-height:200px;overflow-y:auto;display:flex;flex-direction:column-reverse;}
  .log-item{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px solid var(--border-soft);font-size:12px;font-family:var(--mono);}
  .log-item:first-child{border-bottom:none;}
  .log-item .t{color:var(--muted);width:68px;flex-shrink:0;}
  .log-item .c{flex:1;font-weight:600;color:var(--text);}
  .log-item .r{width:110px;text-align:right;font-weight:700;}
  .log-item.ok .r{color:var(--green);}
  .log-item.warn .r{color:var(--amber);}
  .log-item.err .r{color:#ffb199;}
  .log-empty{color:var(--muted);font-size:12.5px;padding:6px 0;}

  table.packlib{width:100%;border-collapse:collapse;font-size:12.5px;}
  table.packlib th{text-align:left;font-family:var(--mono);font-size:10px;text-transform:uppercase;color:var(--muted);padding:6px 8px;border-bottom:1px solid var(--border);}
  table.packlib td{padding:6px 8px;border-bottom:1px solid var(--border-soft);color:var(--text);}
  table.packlib input{width:56px;font-family:var(--mono);font-weight:600;text-align:center;border:1px solid var(--border);background:var(--panel-alt);color:var(--text);border-radius:6px;padding:4px;}
  .lib-empty{color:var(--muted);font-size:12px;padding:8px 0;}

  .upc-form{display:grid;grid-template-columns:1fr 1fr auto;gap:8px;margin-bottom:14px;}
  .upc-form input{background:var(--panel-alt);border:1px solid var(--border);border-radius:7px;padding:9px 11px;color:var(--text);font-family:var(--mono);font-size:13px;}
  .upc-form input:focus{outline:none;border-color:var(--amber);}

  .session-timer{font-family:var(--mono);font-size:20px;font-weight:700;color:var(--blue);text-align:center;padding:8px 0;}
  .session-timer .l{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px;text-align:center;display:block;font-weight:400;}

  .footer-note{text-align:center;color:var(--muted-dim);font-size:11px;margin-top:24px;font-family:var(--mono);}
  [hidden]{display:none !important;}
  :focus-visible{outline:2px solid var(--amber);outline-offset:2px;}

  @media(max-width:900px){
    .layout{flex-direction:column;}
    .sidebar{width:100%;position:static;height:auto;border-right:none;border-bottom:1px solid var(--border);}
    .desc-cell{display:none;}
  }
</style>
</head>
<body>

<div class="login-overlay" id="loginOverlay">
  <div class="login-card">
    <div class="brand">
      <div class="logo-badge"><span>OA</span></div>
      <div><h1>Meridian</h1><p>Outbound Audit</p></div>
    </div>
    <h2>Sign in to audit</h2>
