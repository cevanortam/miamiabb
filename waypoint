  function parseUpcRows(rows){
    const header = detectHeaderRow(rows, ['sku','upc']);
    if(!header || header.map.sku === undefined || header.map.upc === undefined){
      throw new Error('Could not find SKU / UPC columns in this file.');
    }
    const out = [];
    for(let r = header.rowIndex + 1; r < rows.length; r++){
      const row = rows[r] || [];
      const sku = String(row[header.map.sku] ?? '').trim();
      const upc = String(row[header.map.upc] ?? '').trim();
      if(!sku || !upc) continue;
      out.push({ sku, upc });
    }
    return out;
  }

  function addUpcMapping(sku, upc){
    const nSku = normCode(sku), nUpc = normCode(upc);
    if(!nSku || !nUpc) return false;
    upcMap[nUpc] = nSku;
    skuToUpc[nSku] = upc.trim();
    return true;
  }

