<script>
(function(){
  "use strict";

  const CONFIG = {
    containerAlertRecipients: ["Andres.Puente@cevalogistics.com", "jacob.fowler@cevalogistics.com"],
    // Paste the deployed Google Apps Script Web App URL here to enable shared
    // "already audited" checking and logging across everyone using this file.
    // Leave blank to run fully offline (no duplicate-audit detection, no shared log).
    sheetsWebAppUrl: ""
  };

  let rawDataset = [];
  let items = [];
  let scanLog = [];
  let upcMap = {};
  let skuToUpc = {};
  let currentContainerId = null;
  let pendingContainerLaunch = null; // {cid, rows} awaiting the duplicate-audit prompt

  // auth / productivity state
  let users = [{ username: 'admin', password: 'admin' }];
  let settingsPassword = 'admin123';
  let currentUser = null;
  let containerSessions = [];  // committed: {containerId, user, start, end}
  let activeSession = null;    // in progress: {containerId, user, start, lastActivity}
  let sessionTimerHandle = null;

  const el = (id) => document.getElementById(id);
  const normCode = (s) => String(s||'').trim().toUpperCase();

  /* ================= AUTH ================= */
  function attemptLogin(username, password){
    const u = String(username||'').trim();
    const p = String(password||'');
    const match = users.find(x => x.username.toLowerCase() === u.toLowerCase() && x.password === p);
    if(!match){
      const errBox = el('loginError');
      errBox.textContent = 'Incorrect username or password.';
      errBox.classList.add('show');
      return false;
    }
    currentUser = match.username;
    el('loginError').classList.remove('show');
    el('loginOverlay').classList.add('hidden');
    el('userPill').hidden = false;
    el('userPill').textContent = 'Signed in: ' + currentUser;
    el('upcTopbarBtn').hidden = false;
    el('settingsTopbarBtn').hidden = false;
    el('logoutBtn').hidden = false;
    el('loginUsername').value = '';
    el('loginPassword').value = '';

    if(sheetSyncConfigured()){
      Promise.all([pullManifestFromSheet(true), pullUpcMapFromSheet(true)]).then(([manifestOk, upcOk]) => {
        if(manifestOk || upcOk) toast('Shared manifest and UPC data loaded.');
      });
    }
    return true;
  }

  function logout(){
    currentUser = null;
    el('userPill').hidden = true;
    el('upcTopbarBtn').hidden = true;
    el('settingsTopbarBtn').hidden = true;
    el('logoutBtn').hidden = true;
    el('loginOverlay').classList.remove('hidden');
    focusLoginInput();
  }

  function focusLoginInput(){
    setTimeout(()=>{ const inp = el('loginUsername'); if(inp) inp.focus(); }, 30);
  }

  /* ================= SETTINGS (users) ================= */
  function openSettingsModal(){
    el('settingsModalOverlay').classList.remove('hidden');
    el('settingsUnlockedPanel').classList.remove('show');
    el('settingsLock').hidden = false;
    el('settingsUnlockInput').value = '';
    el('settingsUnlockError').classList.remove('show');
    setTimeout(()=>{ const inp = el('settingsUnlockInput'); if(inp) inp.focus(); }, 30);
  }
  function closeSettingsModal(){ el('settingsModalOverlay').classList.add('hidden'); }

  function unlockSettings(){
    const val = el('settingsUnlockInput').value;
    if(val !== settingsPassword){
      const err = el('settingsUnlockError');
      err.textContent = 'Incorrect settings password.';
      err.classList.add('show');
      return;
    }
    el('settingsLock').hidden = true;
    el('settingsUnlockedPanel').classList.add('show');
    renderUserTable();
  }

  function renderUserTable(){
    const body = el('userTableBody');
    if(users.length === 0){
      body.innerHTML = `<tr><td colspan="3" class="lib-empty">No accounts yet.</td></tr>`;
      return;
    }
    body.innerHTML = users.map((u, i) => `
      <tr>
        <td><input type="text" data-useridx="${i}" data-field="username" value="${escapeHtml(u.username)}"></td>
        <td><input type="text" data-useridx="${i}" data-field="password" value="${escapeHtml(u.password)}"></td>
        <td><button class="mini-btn" data-userremove="${i}" title="Remove">&times;</button></td>
      </tr>
    `).join('');
    body.querySelectorAll('input[data-useridx]').forEach(inp=>{
      inp.addEventListener('change', () => {
        const idx = parseInt(inp.dataset.useridx, 10);
        const field = inp.dataset.field;
        const val = inp.value.trim();
        if(!val){ inp.value = users[idx][field]; return; }
        users[idx][field] = val;
        pushUsersToSheet();
      });
    });
    body.querySelectorAll('[data-userremove]').forEach(btn=>{
      btn.addEventListener('click', () => {
        if(users.length <= 1){ toast('At least one account must remain.', true); return; }
        users.splice(parseInt(btn.dataset.userremove, 10), 1);
        renderUserTable();
        pushUsersToSheet();
      });
    });
  }

  function addUser(username, password){
    const u = String(username||'').trim();
    const p = String(password||'').trim();
    if(!u || !p){ toast('Enter both a username and a password.', true); return; }
    if(users.some(x => x.username.toLowerCase() === u.toLowerCase())){ toast('That username already exists.', true); return; }
    users.push({ username: u, password: p });
    renderUserTable();
    toast('Account added.');
    pushUsersToSheet();
  }

  function changeSettingsPassword(newPassword){
    const p = String(newPassword||'').trim();
    if(!p){ toast('Enter a new settings password.', true); return; }
    settingsPassword = p;
    el('settingsNewPassword').value = '';
    toast('Settings password updated.');
    pushUsersToSheet();
  }

  function saveUsersFile(){
    downloadText(JSON.stringify({ savedAt: new Date().toISOString(), users, settingsPassword }, null, 2), `audit-users-${timestamp()}.json`, 'application/json');
  }
  function loadUsersFile(file){
    const reader = new FileReader();
    reader.onload = (e) => {
      try{
        const snap = JSON.parse(e.target.result);
        if(!Array.isArray(snap.users) || snap.users.length === 0) throw new Error('File does not look like a saved users file.');
        users = snap.users;
        if(snap.settingsPassword) settingsPassword = snap.settingsPassword;
        renderUserTable();
        toast(`${users.length} account${users.length===1?'':'s'} loaded.`);
      }catch(err){
        toast('Could not load that users file: ' + err.message, true);
      }
    };
    reader.readAsText(file);
  }

  /* ================= PRODUCTIVITY / SESSIONS ================= */
  function startSession(containerId){
    if(activeSession) commitSession();
    const now = new Date();
    activeSession = { containerId, user: currentUser, start: now, lastActivity: now };
    startSessionTimer();
  }
  function touchSession(){
    if(activeSession) activeSession.lastActivity = new Date();
  }
  function commitSession(finished){
    if(!activeSession) return;
    containerSessions.push({
      containerId: activeSession.containerId,
      user: activeSession.user,
      start: activeSession.start,
      end: activeSession.lastActivity,
      finished: !!finished
    });
    activeSession = null;
    stopSessionTimer();
  }
  function startSessionTimer(){
    el('sessionTimer').hidden = false;
    updateSessionTimerDisplay();
    clearInterval(sessionTimerHandle);
    sessionTimerHandle = setInterval(updateSessionTimerDisplay, 1000);
  }
  function stopSessionTimer(){
    clearInterval(sessionTimerHandle);
    el('sessionTimer').hidden = true;
  }
  function updateSessionTimerDisplay(){
    if(!activeSession) return;
    const seconds = Math.floor((new Date() - activeSession.start) / 1000);
    el('sessionTimerValue').textContent = formatDuration(seconds);
  }
  function formatDuration(totalSeconds){
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    const s = totalSeconds % 60;
    const pad = n => String(n).padStart(2,'0');
    return `${pad(h)}:${pad(m)}:${pad(s)}`;
  }
  function exportProductivity(){
    const rows = [['Container ID','User','Start','End','Duration','Status']];
    containerSessions.forEach(s => {
      const seconds = Math.floor((new Date(s.end) - new Date(s.start)) / 1000);
      rows.push([s.containerId, s.user, new Date(s.start).toLocaleString(), new Date(s.end).toLocaleString(), formatDuration(seconds), s.finished ? 'Finished' : 'Switched']);
    });
    if(activeSession){
      const now = new Date();
      const seconds = Math.floor((now - activeSession.start) / 1000);
      rows.push([activeSession.containerId, activeSession.user, new Date(activeSession.start).toLocaleString(), now.toLocaleString(), formatDuration(seconds), 'In progress']);
    }
    if(rows.length === 1){ toast('No container sessions recorded yet.', true); return; }
    const csv = rows.map(r => r.map(csvEscape).join(',')).join('\n');
    downloadText(csv, `outbound-audit-productivity-${timestamp()}.csv`, 'text/csv');
  }

  function toast(msg, isError){
    const t = el('toast');
    t.textContent = msg;
    t.className = 'toast show' + (isError ? ' error' : '');
    clearTimeout(t._timer);
    t._timer = setTimeout(()=>{ t.className = 'toast'; }, isError ? 6000 : 3200);
  }

  function pdfLibraryAvailable(){
    return typeof window.jspdf !== 'undefined' && typeof window.jspdf.jsPDF !== 'undefined';
  }
  function checkPdfLibrary(){
    const ok = pdfLibraryAvailable();
    el('pdfUnavailableBanner').hidden = ok;
    return ok;
  }

  /* ================= GOOGLE SHEET SYNC (shared audit log, manifest, UPC map, users) ================= */
  function sheetSyncConfigured(){
    return !!(CONFIG.sheetsWebAppUrl && CONFIG.sheetsWebAppUrl.trim());
  }
  function setSyncStatus(state){
    const pill = el('sheetSyncPill');
    if(!sheetSyncConfigured()){
      pill.textContent = 'Sheet sync: not configured';
      pill.className = 'pill';
      return;
    }
    if(state === 'checking'){
      pill.textContent = 'Sheet sync: checking…';
      pill.className = 'pill amber';
    }else if(state === 'error'){
      pill.textContent = 'Sheet sync: connection issue';
      pill.className = 'pill warn';
    }else{
      pill.textContent = 'Sheet sync: connected';
      pill.className = 'pill ok';
    }
  }
  function initSyncStatus(){
    setSyncStatus(sheetSyncConfigured() ? 'connected' : 'not-configured');
  }

  async function sheetGet_(action, extraParams){
    if(!sheetSyncConfigured()) return null;
    try{
      setSyncStatus('checking');
      let url = CONFIG.sheetsWebAppUrl + '?action=' + encodeURIComponent(action);
      if(extraParams){
        Object.keys(extraParams).forEach(k => { url += '&' + k + '=' + encodeURIComponent(extraParams[k]); });
      }
      const res = await fetch(url);
      const data = await res.json();
      setSyncStatus('connected');
      return data;
    }catch(err){
      console.error('Sheet GET (' + action + ') failed:', err);
      setSyncStatus('error');
      return null;
    }
  }

  // Uses text/plain as the content type (rather than application/json) so the browser
  // treats this as a "simple request" and skips the CORS preflight, which Apps Script
  // Web Apps generally don't handle. Never throws — always resolves.
  async function sheetPost_(payload){
    if(!sheetSyncConfigured()) return { ok:false, skipped:true };
    try{
      setSyncStatus('checking');
      const res = await fetch(CONFIG.sheetsWebAppUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      setSyncStatus('connected');
      return data && typeof data.ok !== 'undefined' ? data : { ok: true };
    }catch(err){
      console.error('Sheet POST (' + (payload && payload.action) + ') failed:', err);
      setSyncStatus('error');
      return { ok:false, error: String(err) };
    }
  }

