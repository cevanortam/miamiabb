      </tr>
    `).join('');
    body.querySelectorAll('[data-upcremove]').forEach(btn=>{
      btn.addEventListener('click', () => {
        const upc = btn.dataset.upcremove;
        const sku = upcMap[upc];
        delete upcMap[upc];
        if(sku && skuToUpc[sku] && normCode(skuToUpc[sku]) === upc) delete skuToUpc[sku];
        renderUpcTable(el('upcSearch').value);
        renderUpcTile();
        renderManifestTable(currentFilter());
        pushUpcMapToSheet();
      });
    });
  }

