  function resolveToSku(rawCode){
    const nc = normCode(rawCode);
    if(upcMap[nc]) return upcMap[nc];
    return nc;
  }

  function findMatch(rawCode){
    const resolved = resolveToSku(rawCode);
    let candidates = items.filter(i => normCode(i.sku) === resolved);
    if(candidates.length){
      const open = candidates.find(i => i.expected - i.scanned > 0);
      return { item: open || candidates[0] };
    }
    candidates = items.filter(i => resolved.includes(normCode(i.sku)) || normCode(i.sku).includes(resolved));
    if(candidates.length){
      candidates.sort((a,b) => normCode(b.sku).length - normCode(a.sku).length);
      const open = candidates.find(i => i.expected - i.scanned > 0);
      return { item: open || candidates[0] };
    }
    return null;
  }

  function processScan(code){
    const trimmed = String(code||'').trim();
    if(!trimmed) return;

    const qty = Math.max(parseInt(el('scanQtyInput').value, 10) || 1, 1);

    const match = findMatch(trimmed);
    if(!match){
      logScan(trimmed, 'err', 'No matching SKU on manifest', null, 0);
      setFeedback('err', 'Unknown code', trimmed);
      renderLog();
      return;
    }

    applyUnits(match.item, qty, trimmed);
    renderAllAfterScan();
    resetScanQty();
  }

  function resetScanQty(){
    el('scanQtyInput').value = 1;
  }

  function applyUnits(item, count, code){
    touchSession();
    item.scanned += count;
    const remaining = Math.max(item.expected - item.scanned, 0);
    const over = Math.max(item.scanned - item.expected, 0);
    const result = over > 0 ? 'warn' : 'ok';
    const detail = over > 0
      ? `${item.sku} — +${count} — ${over} over`
      : `${item.sku} — +${count} — ${remaining} left`;
    logScan(code, result, detail, item.id, count);
    if(over > 0){
      setFeedback('warn', `Over-scanned ${item.sku}`, `+${count} pushed it ${over} past expected`);
    }else{
      setFeedback('ok', `Matched ${item.sku}`, `+${count} — ${remaining} of ${item.expected} remaining`);
    }
    flashRow(item.id);
  }

  function logScan(code, result, detail, itemId, units){
    const time = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit'});
    scanLog.push({ time, code, result, detail, itemId, units });
  }
  function setFeedback(kind, title, sub){
    const box = el('scanFeedback');
    box.className = 'scan-feedback ' + kind;
    box.innerHTML = `<span>${escapeHtml(title)}</span>${sub ? `<span class="fb-badge">${escapeHtml(sub)}</span>` : ''}`;
  }
  function flashRow(itemId){
    const row = document.querySelector(`tr[data-item="${itemId}"]`);
    if(row){ row.classList.remove('just-scanned'); void row.offsetWidth; row.classList.add('just-scanned'); }
  }

  function undoLastScan(){
    for(let i = scanLog.length - 1; i >= 0; i--){
      const entry = scanLog[i];
      if(entry.itemId && entry.units){
        const item = items.find(it => it.id === entry.itemId);
        if(item) item.scanned = Math.max(item.scanned - entry.units, 0);
        scanLog.splice(i, 1);
        renderAllAfterScan();
        setFeedback('warn', 'Last scan undone', entry.code);
        return;
      }
    }
    setFeedback('warn', 'Nothing to undo', '');
  }

  function adjustItem(id, delta){
    const item = items.find(i => i.id === id);
    if(!item) return;
    touchSession();
    item.scanned = Math.max(item.scanned + delta, 0);
    renderStats(); renderManifestTable(currentFilter());
  }

  function currentFilter(){ const f = el('tableSearch'); return f ? f.value : ''; }
  function renderAllAfterScan(){
    renderStats(); renderManifestTable(currentFilter()); renderLog();
  }

  function renderStats(){
    const totalLines = items.length;
    const doneLines = items.filter(i => i.expected - i.scanned <= 0).length;
    const totalExpected = items.reduce((s,i)=>s+i.expected,0);
    const totalScanned = items.reduce((s,i)=>s+Math.min(i.scanned,i.expected),0);
    const totalOver = items.reduce((s,i)=>s+Math.max(i.scanned-i.expected,0),0);
    const totalRemaining = totalExpected - totalScanned;
    const pct = totalExpected ? Math.round((totalScanned/totalExpected)*100) : 0;

    el('statLines').textContent = `${doneLines}/${totalLines}`;
    el('statExpected').textContent = totalExpected;
    el('statScanned').textContent = totalScanned;
    el('statRemaining').textContent = totalRemaining;
    el('progressFill').style.width = pct + '%';
    el('statRemainingBox').classList.toggle('complete', totalRemaining === 0);

    const banner = el('overBanner');
    if(totalOver > 0){
      banner.hidden = false;
      banner.textContent = `${totalOver} unit${totalOver===1?'':'s'} scanned beyond expected quantity — check for double scans.`;
    }else{
      banner.hidden = true;
    }
  }

  function statusFor(item){
    const remaining = item.expected - item.scanned;
    if(remaining < 0) return {cls:'over', label:'Over +'+(-remaining)};
    if(remaining === 0) return {cls:'complete', label:'Complete'};
    if(item.scanned > 0) return {cls:'progress', label:'In progress'};
    return {cls:'pending', label:'Pending'};
  }

  function renderManifestTable(filterText){
    const body = el('manifestBody');
    body.innerHTML = '';
    const q = (filterText||'').toLowerCase().trim();
    const rows = items.filter(i => !q || i.sku.toLowerCase().includes(q) || (i.description||'').toLowerCase().includes(q));

    if(rows.length === 0){
      body.innerHTML = `<tr class="empty-row"><td colspan="8">${items.length ? 'No lines match "'+escapeHtml(filterText)+'"' : 'No manifest lines.'}</td></tr>`;
      return;
    }

    body.innerHTML = rows.map(item => {
      const remaining = item.expected - item.scanned;
      const over = Math.max(item.scanned-item.expected,0);
      const st = statusFor(item);
      const upc = skuToUpc[normCode(item.sku)];
      return `
        <tr data-item="${item.id}">
          <td class="sku-cell">${escapeHtml(item.sku)}</td>
          <td class="upc-cell">${upc ? escapeHtml(upc) : '—'}</td>
          <td class="desc-cell">${escapeHtml(item.description)}</td>
          <td class="qty-cell">${item.expected}</td>
          <td class="qty-cell">${item.scanned}${over ? ` <span style="color:var(--red)">(+${over})</span>` : ''}</td>
          <td class="remaining-cell ${remaining<=0?'zero':''} ${over>0?'over':''}">${Math.max(remaining,0)}</td>
          <td><span class="status-chip ${st.cls}">${st.label}</span></td>
          <td>
            <div class="row-controls">
              <button class="mini-btn" data-adjust="${item.id}" data-delta="-1" title="Remove one unit">&minus;</button>
              <button class="mini-btn" data-adjust="${item.id}" data-delta="1" title="Add one unit manually">+</button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    body.querySelectorAll('[data-adjust]').forEach(btn=>{
      btn.addEventListener('click', ()=> adjustItem(btn.dataset.adjust, parseInt(btn.dataset.delta,10)));
    });
  }

  function renderLog(){
    const list = el('logList');
    if(scanLog.length === 0){ list.innerHTML = '<div class="log-empty">No scans yet.</div>'; return; }
    list.innerHTML = scanLog.slice(-40).map(l => `
      <div class="log-item ${l.result}">
        <span class="t">${l.time}</span>
        <span class="c">${escapeHtml(l.code)}</span>
        <span class="r">${escapeHtml(l.detail)}</span>
      </div>
    `).join('');
  }

  function renderAll(){ renderStats(); renderManifestTable(currentFilter()); renderLog(); }

  function saveProgress(){
    const snapshot = { savedAt: new Date().toISOString(), currentContainerId, items, scanLog, activeSession };
    downloadText(JSON.stringify(snapshot, null, 2), `outbound-audit-progress-${timestamp()}.json`, 'application/json');
  }
  function loadProgress(file){
    const reader = new FileReader();
    reader.onload = (e) => {
      try{
        const snap = JSON.parse(e.target.result);
        if(!Array.isArray(snap.items)) throw new Error('File does not look like a saved progress file.');
        items = snap.items;
        scanLog = snap.scanLog || [];
        currentContainerId = snap.currentContainerId || 'RESUMED';
        if(snap.activeSession && snap.activeSession.containerId){
          activeSession = {
            containerId: snap.activeSession.containerId,
            user: snap.activeSession.user || currentUser,
            start: new Date(snap.activeSession.start),
            lastActivity: new Date()
          };
          startSessionTimer();
        }else{
          startSession(currentContainerId);
        }
        launchAuditWorkspace();
      }catch(err){
        toast('Could not load that progress file: ' + err.message, true);
      }
    };
    reader.readAsText(file);
  }
  function exportReport(){
    const rows = [['Container ID','SKU','UPC','Description','Expected Qty','Scanned Qty','Over-scanned','Remaining','Status']];
    items.forEach(i=>{
      const remaining = Math.max(i.expected - i.scanned, 0);
      const over = Math.max(i.scanned - i.expected, 0);
      const upc = skuToUpc[normCode(i.sku)] || '';
      rows.push([currentContainerId, i.sku, upc, i.description, i.expected, i.scanned, over, remaining, statusFor(i).label]);
    });
    const csv = rows.map(r => r.map(csvEscape).join(',')).join('\n');
    downloadText(csv, `outbound-audit-report-${timestamp()}.csv`, 'text/csv');
  }

  function csvEscape(v){
    const s = String(v===undefined||v===null?'':v);
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
  }
  function downloadText(text, filename, mime){
    const blob = new Blob([text], {type: mime});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
  }
  function timestamp(){
    const d = new Date();
    const pad = n => String(n).padStart(2,'0');
    return `${d.getFullYear()}${pad(d.getMonth()+1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}`;
  }
  function escapeHtml(s){
    return String(s===undefined||s===null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function openUpcModal(){ el('upcModalOverlay').classList.remove('hidden'); renderUpcTable(''); }
  function closeUpcModal(){ el('upcModalOverlay').classList.add('hidden'); }

  const datasetDz = el('datasetDropzone');
  datasetDz.addEventListener('dragover', e => { e.preventDefault(); datasetDz.classList.add('drag'); });
  datasetDz.addEventListener('dragleave', () => datasetDz.classList.remove('drag'));
  datasetDz.addEventListener('drop', e => { e.preventDefault(); datasetDz.classList.remove('drag'); if(e.dataTransfer.files[0]) handleDatasetFile(e.dataTransfer.files[0]); });
  el('datasetInput').addEventListener('change', e => { if(e.target.files[0]) handleDatasetFile(e.target.files[0]); });
  el('clearDatasetBtn').addEventListener('click', clearDataset);
  el('datasetRefreshBtn').addEventListener('click', () => pullManifestFromSheet(false));

  el('containerInput').addEventListener('keydown', e => {
    if(e.key === 'Enter'){
      e.preventDefault();
      const val = el('containerInput').value;
      scanContainer(val);
    }
  });

  el('duplicateAuditAgainBtn').addEventListener('click', () => {
    closeDuplicateAuditModal();
    if(pendingContainerLaunch){
      const { cid, rows } = pendingContainerLaunch;
      pendingContainerLaunch = null;
      launchContainerFromRows(cid, rows);
    }
  });
  el('duplicateAuditBackBtn').addEventListener('click', () => {
    closeDuplicateAuditModal();
    pendingContainerLaunch = null;
    el('containerInput').value = '';
    focusContainerInput();
  });
  el('duplicateAuditModalClose').addEventListener('click', () => {
    closeDuplicateAuditModal();
    pendingContainerLaunch = null;
    focusContainerInput();
  });
  el('duplicateAuditModalOverlay').addEventListener('click', e => {
    if(e.target === el('duplicateAuditModalOverlay')){
      closeDuplicateAuditModal();
      pendingContainerLaunch = null;
      focusContainerInput();
    }
  });

  el('changeContainerBtn').addEventListener('click', changeContainer);
  el('changeContainerBtn2').addEventListener('click', changeContainer);
  el('finishAuditBtn').addEventListener('click', finishAudit);
  el('finishAuditBtn2').addEventListener('click', finishAudit);

  el('scanInput').addEventListener('keydown', e => {
    if(e.key === 'Enter'){
      e.preventDefault();
      const val = el('scanInput').value;
      el('scanInput').value = '';
      processScan(val);
      focusScanInput();
    }
  });
  el('scanQtyInput').addEventListener('focus', () => el('scanQtyInput').select());
  el('scanQtyInput').addEventListener('keydown', e => {
    if(e.key === 'Enter'){
      e.preventDefault();
      focusScanInput();
    }
  });
  document.addEventListener('click', (e) => {
    if(!currentUser) return;
    if(!el('auditWorkspace').hidden
      && !e.target.closest('.mini-btn') && !e.target.closest('#tableSearch') && !e.target.closest('.btn')
      && !e.target.closest('.modal-overlay')
      && !e.target.closest('#scanQtyInput')){
      focusScanInput();
    }
    if(el('containerHero') && !el('containerHero').hidden
      && !e.target.closest('.btn') && !e.target.closest('.notfound-box')){
      focusContainerInput();
    }
  });
  el('tableSearch').addEventListener('input', () => renderManifestTable(el('tableSearch').value));

  el('undoBtn').addEventListener('click', undoLastScan);

  el('saveProgressBtn').addEventListener('click', saveProgress);
  el('loadProgressBtn').addEventListener('click', () => el('progressInput').click());
  el('progressInput').addEventListener('change', e => { if(e.target.files[0]) loadProgress(e.target.files[0]); });
  el('exportBtn').addEventListener('click', exportReport);

  el('upcTopbarBtn').addEventListener('click', openUpcModal);
  el('upcModalClose').addEventListener('click', closeUpcModal);
  el('upcModalOverlay').addEventListener('click', e => { if(e.target === el('upcModalOverlay')) closeUpcModal(); });

  const upcDz = el('upcDropzone');
  upcDz.addEventListener('dragover', e => { e.preventDefault(); upcDz.classList.add('drag'); });
  upcDz.addEventListener('dragleave', () => upcDz.classList.remove('drag'));
  upcDz.addEventListener('drop', e => { e.preventDefault(); upcDz.classList.remove('drag'); if(e.dataTransfer.files[0]) handleUpcBulkFile(e.dataTransfer.files[0]); });
  el('upcBulkInput').addEventListener('change', e => { if(e.target.files[0]) handleUpcBulkFile(e.target.files[0]); });

  el('upcFormAddBtn').addEventListener('click', () => {
    const sku = el('upcFormSku').value.trim();
    const upc = el('upcFormUpc').value.trim();
    if(!sku || !upc){ toast('Enter both a SKU and a UPC.', true); return; }
    addUpcMapping(sku, upc);
    el('upcFormSku').value = ''; el('upcFormUpc').value = '';
    renderUpcTable(el('upcSearch').value);
    renderUpcTile();
    renderManifestTable(currentFilter());
    if(!sheetSyncConfigured()){
      toast('Mapping saved.');
    }else{
      pushUpcMapToSheet().then(res => {
        toast(res && res.ok ? 'Mapping saved and shared with everyone.' : 'Mapping saved locally, but sharing it failed (check your connection).', !(res && res.ok));
      });
    }
  });
  el('upcSearch').addEventListener('input', () => renderUpcTable(el('upcSearch').value));
  el('upcSaveLibBtn').addEventListener('click', saveUpcLibrary);
  el('upcRefreshBtn').addEventListener('click', () => pullUpcMapFromSheet(false));

  /* ---- auth events ---- */
  el('loginBtn').addEventListener('click', () => attemptLogin(el('loginUsername').value, el('loginPassword').value));
  el('loginPassword').addEventListener('keydown', e => { if(e.key === 'Enter'){ e.preventDefault(); attemptLogin(el('loginUsername').value, el('loginPassword').value); } });
  el('loginUsername').addEventListener('keydown', e => { if(e.key === 'Enter'){ e.preventDefault(); el('loginPassword').focus(); } });
  el('logoutBtn').addEventListener('click', logout);

  /* ---- settings events ---- */
  el('settingsTopbarBtn').addEventListener('click', openSettingsModal);
  el('settingsModalClose').addEventListener('click', closeSettingsModal);
  el('settingsModalOverlay').addEventListener('click', e => { if(e.target === el('settingsModalOverlay')) closeSettingsModal(); });
  el('settingsUnlockBtn').addEventListener('click', unlockSettings);
  el('settingsUnlockInput').addEventListener('keydown', e => { if(e.key === 'Enter'){ e.preventDefault(); unlockSettings(); } });
  el('userFormAddBtn').addEventListener('click', () => {
    addUser(el('userFormUsername').value, el('userFormPassword').value);
    el('userFormUsername').value = ''; el('userFormPassword').value = '';
  });
  el('userFormPassword').addEventListener('keydown', e => { if(e.key === 'Enter'){ e.preventDefault(); addUser(el('userFormUsername').value, el('userFormPassword').value); el('userFormUsername').value=''; el('userFormPassword').value=''; } });
  el('settingsChangePasswordBtn').addEventListener('click', () => changeSettingsPassword(el('settingsNewPassword').value));
  el('saveUsersBtn').addEventListener('click', saveUsersFile);
  el('usersRefreshBtn').addEventListener('click', () => pullUsersFromSheet(false));
  el('loadUsersBtn').addEventListener('click', () => el('usersFileInput').click());
  el('usersFileInput').addEventListener('change', e => { if(e.target.files[0]) loadUsersFile(e.target.files[0]); });

  /* ---- productivity events ---- */
  el('exportProductivityBtn').addEventListener('click', exportProductivity);

  renderUpcTile();
  checkPdfLibrary();
  initSyncStatus();
  if(sheetSyncConfigured()) pullUsersFromSheet(true);
  focusLoginInput();

})();
</script>
</body>
</html>
