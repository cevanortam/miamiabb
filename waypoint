  async function scanContainer(rawId){
    const cid = String(rawId||'').trim();
    if(!cid) return;
    if(rawDataset.length === 0){ toast('Manifest data has not been loaded yet.', true); return; }

    const rows = rawDataset.filter(r => normCode(r.containerId) === normCode(cid));
    el('notfoundBox').hidden = true;

    if(rows.length === 0){
      showContainerNotFound(cid);
      return;
    }

    el('containerInput').disabled = true;
    const prior = await checkContainerAudited(cid);
    el('containerInput').disabled = false;

    if(prior){
      pendingContainerLaunch = { cid, rows };
      showDuplicateAuditModal(cid, prior);
      return;
    }

    launchContainerFromRows(cid, rows);
  }

  function launchContainerFromRows(cid, rows){
    const grouped = {};
    rows.forEach(r => {
      const key = normCode(r.sku);
      if(!grouped[key]) grouped[key] = { sku: r.sku, description: r.description, expected: 0 };
      grouped[key].expected += r.qty;
      if(!grouped[key].description && r.description) grouped[key].description = r.description;
    });

    items = Object.keys(grouped).map((key, i) => ({
      id: 'it_' + i,
      sku: grouped[key].sku,
      description: grouped[key].description,
      expected: grouped[key].expected,
      scanned: 0
    }));
    scanLog = [];
    currentContainerId = cid;
    startSession(cid);
    launchAuditWorkspace();
  }

