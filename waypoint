  async function finishAudit(){
    if(!checkPdfLibrary()){
      toast('PDF library did not load — check your internet connection, reload the page, and try again.', true);
      return;
    }
    const totalExpected = items.reduce((s,i)=>s+i.expected,0);
    const totalScanned = items.reduce((s,i)=>s+Math.min(i.scanned,i.expected),0);
    const totalOver = items.reduce((s,i)=>s+Math.max(i.scanned-i.expected,0),0);
    const incompleteLines = items.filter(i => i.expected - i.scanned !== 0).length;

    let warnMsg = `Finish audit for container ${currentContainerId}?`;
    if(incompleteLines > 0 || totalOver > 0){
      warnMsg += `\n\nHeads up: ${incompleteLines} line${incompleteLines===1?'':'s'} ${incompleteLines===1?'is':'are'} not at expected quantity` + (totalOver>0 ? ` (${totalOver} unit${totalOver===1?'':'s'} over).` : '.') + ' The PDF will reflect this as-is.';
    }
    if(!confirm(warnMsg)) return;

    // snapshot everything needed for the PDF before we touch state
    const snapshot = {
      containerId: currentContainerId,
      user: currentUser,
      start: activeSession ? activeSession.start : null,
      items: items.map(i => ({...i})),
    };

    commitSession(true);
    const finishedRecord = containerSessions[containerSessions.length - 1];
    snapshot.start = finishedRecord ? finishedRecord.start : snapshot.start;
    snapshot.end = finishedRecord ? finishedRecord.end : new Date();

    let pdfOk = true;
    try{
      generateAuditPdf(snapshot, totalExpected, totalScanned, totalOver);
    }catch(err){
      pdfOk = false;
      toast('PDF generation failed: ' + err.message, true);
    }

    if(pdfOk){
      const durationSeconds = Math.floor((new Date(snapshot.end) - new Date(snapshot.start)) / 1000);
      const syncResult = await logFinishedAuditToSheet({
        containerId: snapshot.containerId,
        user: snapshot.user,
        start: new Date(snapshot.start).toISOString(),
        end: new Date(snapshot.end).toISOString(),
        duration: formatDuration(durationSeconds),
        status: 'Finished'
      });
      if(!sheetSyncConfigured()){
        toast('Audit finished — PDF saved to your downloads.');
      }else if(syncResult && syncResult.ok){
        toast('Audit finished — PDF saved and logged to the shared sheet.');
      }else{
        toast('Audit finished — PDF saved, but the shared sheet log failed (check your connection).', true);
      }
    }

    resetToContainerHero();
  }

  function generateAuditPdf(snapshot, totalExpected, totalScanned, totalOver){
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit: 'pt', format: 'letter' });
    const marginX = 40;
    let y = 50;

    doc.setFont('helvetica', 'bold');
    doc.setFontSize(16);
    doc.text('Outbound Audit Report', marginX, y);
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.setTextColor(120);
    y += 16;
    doc.text('Meridian | Outbound Audit', marginX, y);
    doc.setTextColor(20);

    y += 26;
    const seconds = Math.floor((new Date(snapshot.end) - new Date(snapshot.start)) / 1000);
    const infoRows = [
      ['Container ID', snapshot.containerId],
      ['Audited by (user ID)', snapshot.user || 'Unknown'],
      ['Start time', new Date(snapshot.start).toLocaleString()],
      ['End time', new Date(snapshot.end).toLocaleString()],
      ['Total duration', formatDuration(seconds)],
      ['Report generated', new Date().toLocaleString()]
    ];
    doc.setFontSize(10);
    infoRows.forEach(([label, val]) => {
      doc.setFont('helvetica', 'bold');
      doc.text(label + ':', marginX, y);
      doc.setFont('helvetica', 'normal');
      doc.text(String(val), marginX + 140, y);
      y += 15;
    });

    y += 6;
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(11);
    doc.text('Summary', marginX, y);
    y += 16;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    const totalRemaining = Math.max(totalExpected - totalScanned, 0);
    const summaryLine = `${snapshot.items.length} line${snapshot.items.length===1?'':'s'} — ${totalExpected} expected, ${totalScanned} scanned, ${totalRemaining} remaining` + (totalOver > 0 ? `, ${totalOver} over` : '');
    doc.text(summaryLine, marginX, y);
    y += 20;

    const body = snapshot.items.map(item => {
      const remaining = item.expected - item.scanned;
      const over = Math.max(item.scanned - item.expected, 0);
      const upc = skuToUpc[normCode(item.sku)] || '—';
      let status = 'Pending';
      if(remaining < 0) status = 'Over +' + (-remaining);
      else if(remaining === 0) status = 'Complete';
      else if(item.scanned > 0) status = 'In progress';
      return [
        item.sku,
        upc,
        item.description || '',
        String(item.expected),
        String(item.scanned),
        String(Math.max(remaining, 0)),
        status
      ];
    });

    doc.autoTable({
      startY: y,
      margin: { left: marginX, right: marginX },
      head: [['SKU','UPC','Description','Expected','Scanned','Remaining','Status']],
      body: body,
      styles: { font: 'helvetica', fontSize: 8.5, cellPadding: 4 },
      headStyles: { fillColor: [26,31,39], textColor: 255 },
      didParseCell: (data) => {
        if(data.section === 'body' && data.column.dataKey === 6){
          const val = String(data.cell.raw);
          if(val === 'Complete') data.cell.styles.textColor = [30,120,80];
          else if(val.indexOf('Over') === 0) data.cell.styles.textColor = [190,60,40];
          else if(val === 'Pending') data.cell.styles.textColor = [140,140,140];
        }
      }
    });

    const filenameSafeId = String(snapshot.containerId).replace(/[^A-Za-z0-9_-]/g, '');
    doc.save(`outbound-audit-${filenameSafeId}-${timestamp()}.pdf`);
  }

