        if(parsed.length === 0) throw new Error('No usable SKU / UPC rows found.');
        let count = 0;
        parsed.forEach(p => { if(addUpcMapping(p.sku, p.upc)) count++; });
        el('upcBulkStatus').classList.add('show');
        el('upcBulkStatusText').textContent = `${count} mapping${count===1?'':'s'} loaded.`;
