          });
        }
      }catch(e2){
        toast('Could not parse this file: ' + e2.message, true);
      }
    });
  }

  function renderUpcTile(){
    const count = Object.keys(upcMap).length;
    el('upcTopbarBtn').textContent = count > 0 ? `UPC Mapping (${count})` : 'UPC Mapping';
  }

  function renderUpcTable(filterText){
    const body = el('upcTableBody');
    const q = (filterText||'').toLowerCase().trim();
    const entries = Object.keys(upcMap).map(upc => ({ upc, sku: upcMap[upc] }))
      .filter(e => !q || e.upc.toLowerCase().includes(q) || e.sku.toLowerCase().includes(q))
      .sort((a,b)=> a.sku.localeCompare(b.sku));
    if(entries.length === 0){
      body.innerHTML = `<tr><td colspan="3" class="lib-empty">No UPC mappings yet.</td></tr>`;
      return;
    }
    body.innerHTML = entries.map(e => `
      <tr>
        <td class="sku-cell">${escapeHtml(e.sku)}</td>
        <td class="upc-cell">${escapeHtml(e.upc)}</td>
